@prefix : <http://example.org/tsl-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dbo: <http://dbpedia.org/ontology/> .

# =============================================================================
# ONTOLOGY METADATA
# =============================================================================

<http://example.org/tsl-ontology>
    a owl:Ontology ;
    dc:title "Turkish Super Lig Football Ontology"@en ;
    dc:description "A formal knowledge model for professional football in the Turkish Super Lig, covering teams, players, matches, goals, cards, transfers, stadiums, and coaching staff."@en ;
    dc:creator "Cemil and Group Members" ;
    dcterms:created "2026-04-28"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "tsl" ;
    vann:preferredNamespaceUri "http://example.org/tsl-ontology#" .

# =============================================================================
# CLASSES
# =============================================================================

# --- Core Classes ---

:League
    a owl:Class ;
    rdfs:label "League"@en ;
    rdfs:comment "A professional football league organization that hosts competitive seasons."@en .

:Season
    a owl:Class ;
    rdfs:label "Season"@en ;
    rdfs:comment "A specific competitive season within a league, typically spanning one year (e.g., 2024-2025)."@en .

:Team
    a owl:Class ;
    rdfs:label "Team"@en ;
    rdfs:comment "A professional football club that participates in a league."@en ;
    rdfs:subClassOf schema:SportsTeam .

:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human individual involved in professional football."@en ;
    rdfs:subClassOf foaf:Person .

:Player
    a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Player"@en ;
    rdfs:comment "A professional football player who is registered to play for a team."@en .

:Coach
    a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Coach"@en ;
    rdfs:comment "A head coach or manager responsible for leading a team."@en .

:Match
    a owl:Class ;
    rdfs:label "Match"@en ;
    rdfs:comment "A competitive football match played between two teams within a league season."@en ;
    rdfs:subClassOf schema:SportsEvent .

:Stadium
    a owl:Class ;
    rdfs:label "Stadium"@en ;
    rdfs:comment "A sports venue where football matches are played."@en ;
    rdfs:subClassOf schema:StadiumOrArena .

# --- Event Classes ---

:MatchEvent
    a owl:Class ;
    rdfs:label "Match Event"@en ;
    rdfs:comment "An event that occurs during a football match, such as a goal or a card."@en .

:Goal
    a owl:Class ;
    rdfs:subClassOf :MatchEvent ;
    rdfs:label "Goal"@en ;
    rdfs:comment "A goal scored by a player during a match."@en .

:Card
    a owl:Class ;
    rdfs:subClassOf :MatchEvent ;
    rdfs:label "Card"@en ;
    rdfs:comment "A disciplinary card shown to a player by the referee during a match."@en .

:YellowCard
    a owl:Class ;
    rdfs:subClassOf :Card ;
    rdfs:label "Yellow Card"@en ;
    rdfs:comment "A caution card shown to a player for a minor foul or unsporting behavior."@en .

:RedCard
    a owl:Class ;
    rdfs:subClassOf :Card ;
    rdfs:label "Red Card"@en ;
    rdfs:comment "A dismissal card shown to a player, resulting in ejection from the match."@en .

# --- Transfer Class ---

:Transfer
    a owl:Class ;
    rdfs:label "Transfer"@en ;
    rdfs:comment "A player transfer transaction between two clubs, recording the movement of a player from one team to another."@en .

# --- Position Class ---

:Position
    a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:comment "A playing position on the football field."@en .

:Goalkeeper
    a owl:Class ;
    rdfs:subClassOf :Position ;
    rdfs:label "Goalkeeper"@en ;
    rdfs:comment "The player position responsible for guarding the goal."@en .

:Defender
    a owl:Class ;
    rdfs:subClassOf :Position ;
    rdfs:label "Defender"@en ;
    rdfs:comment "A player position focused on preventing the opposing team from scoring."@en .

:Midfielder
    a owl:Class ;
    rdfs:subClassOf :Position ;
    rdfs:label "Midfielder"@en ;
    rdfs:comment "A player position that operates in the middle of the field, linking defense and attack."@en .

:Forward
    a owl:Class ;
    rdfs:subClassOf :Position ;
    rdfs:label "Forward"@en ;
    rdfs:comment "A player position primarily responsible for scoring goals."@en .

# --- Disjointness Axioms ---

:Player owl:disjointWith :Coach .
:YellowCard owl:disjointWith :RedCard .
:Goalkeeper owl:disjointWith :Defender , :Midfielder , :Forward .
:Defender owl:disjointWith :Midfielder , :Forward .
:Midfielder owl:disjointWith :Forward .

# =============================================================================
# OBJECT PROPERTIES
# =============================================================================

# --- Team & Player Relationships ---

:playsFor
    a owl:ObjectProperty ;
    rdfs:label "plays for"@en ;
    rdfs:comment "Indicates which team a player is currently registered to play for."@en ;
    rdfs:domain :Player ;
    rdfs:range :Team .

:hasPlayer
    a owl:ObjectProperty ;
    owl:inverseOf :playsFor ;
    rdfs:label "has player"@en ;
    rdfs:comment "Indicates that a team has a specific player in its roster."@en ;
    rdfs:domain :Team ;
    rdfs:range :Player .

:hasPosition
    a owl:ObjectProperty ;
    rdfs:label "has position"@en ;
    rdfs:comment "Indicates the playing position of a player on the field."@en ;
    rdfs:domain :Player ;
    rdfs:range :Position .

# --- Coaching Relationships ---

:managedBy
    a owl:ObjectProperty ;
    rdfs:label "managed by"@en ;
    rdfs:comment "Indicates the head coach who manages a team in a given context."@en ;
    rdfs:domain :Team ;
    rdfs:range :Coach .

:manages
    a owl:ObjectProperty ;
    owl:inverseOf :managedBy ;
    rdfs:label "manages"@en ;
    rdfs:comment "Indicates which team a coach is managing."@en ;
    rdfs:domain :Coach ;
    rdfs:range :Team .

# --- League & Season Relationships ---

:belongsToLeague
    a owl:ObjectProperty ;
    rdfs:label "belongs to league"@en ;
    rdfs:comment "Indicates that a team participates in a specific league."@en ;
    rdfs:domain :Team ;
    rdfs:range :League .

:inSeason
    a owl:ObjectProperty ;
    rdfs:label "in season"@en ;
    rdfs:comment "Indicates the season in which a match or transfer takes place."@en ;
    rdfs:range :Season .

:seasonOfLeague
    a owl:ObjectProperty ;
    rdfs:label "season of league"@en ;
    rdfs:comment "Links a season to the league it belongs to."@en ;
    rdfs:domain :Season ;
    rdfs:range :League .

# --- Match Relationships ---

:homeTeam
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "home team"@en ;
    rdfs:comment "The team playing at home in a match."@en ;
    rdfs:domain :Match ;
    rdfs:range :Team .

:awayTeam
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "away team"@en ;
    rdfs:comment "The visiting team in a match."@en ;
    rdfs:domain :Match ;
    rdfs:range :Team .

:playedAtStadium
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "played at stadium"@en ;
    rdfs:comment "The stadium where a match is played."@en ;
    rdfs:domain :Match ;
    rdfs:range :Stadium .

:homeStadium
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "home stadium"@en ;
    rdfs:comment "The home stadium of a team."@en ;
    rdfs:domain :Team ;
    rdfs:range :Stadium .

# --- Goal Relationships ---

:scoredBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scored by"@en ;
    rdfs:comment "The player who scored the goal."@en ;
    rdfs:domain :Goal ;
    rdfs:range :Player .

:assistedBy
    a owl:ObjectProperty ;
    rdfs:label "assisted by"@en ;
    rdfs:comment "The player who provided the assist for a goal."@en ;
    rdfs:domain :Goal ;
    rdfs:range :Player .

:goalInMatch
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "goal in match"@en ;
    rdfs:comment "The match in which a goal was scored."@en ;
    rdfs:domain :Goal ;
    rdfs:range :Match .

:goalForTeam
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "goal for team"@en ;
    rdfs:comment "The team that scored the goal."@en ;
    rdfs:domain :Goal ;
    rdfs:range :Team .

# --- Card Relationships ---

:cardShownTo
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "card shown to"@en ;
    rdfs:comment "The player who received the card."@en ;
    rdfs:domain :Card ;
    rdfs:range :Player .

:cardInMatch
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "card in match"@en ;
    rdfs:comment "The match in which the card was shown."@en ;
    rdfs:domain :Card ;
    rdfs:range :Match .

# --- Transfer Relationships ---

:transferPlayer
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transfer player"@en ;
    rdfs:comment "The player who is being transferred."@en ;
    rdfs:domain :Transfer ;
    rdfs:range :Player .

:transferredFrom
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transferred from"@en ;
    rdfs:comment "The club that the player is leaving."@en ;
    rdfs:domain :Transfer ;
    rdfs:range :Team .

:transferredTo
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transferred to"@en ;
    rdfs:comment "The club that the player is joining."@en ;
    rdfs:domain :Transfer ;
    rdfs:range :Team .

# --- General Event Property ---

:eventInMatch
    a owl:ObjectProperty ;
    rdfs:label "event in match"@en ;
    rdfs:comment "Links a match event to the match it occurred in."@en ;
    rdfs:domain :MatchEvent ;
    rdfs:range :Match .

# --- Property Chain Axiom ---
# If a goal is scored by a player, and that player plays for a team,
# then we can infer the goal is for that team.
# :goalForTeam owl:propertyChainAxiom ( :scoredBy :playsFor ) .

# =============================================================================
# DATA PROPERTIES
# =============================================================================

# --- Person Data Properties ---

:birthDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "birth date"@en ;
    rdfs:comment "The date of birth of a person."@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:date .

:nationality
    a owl:DatatypeProperty ;
    rdfs:label "nationality"@en ;
    rdfs:comment "The nationality or country of citizenship of a person."@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

# --- Player Data Properties ---

:jerseyNumber
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "jersey number"@en ;
    rdfs:comment "The shirt number worn by a player."@en ;
    rdfs:domain :Player ;
    rdfs:range xsd:integer .

:marketValue
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market value"@en ;
    rdfs:comment "The estimated market value of a player in euros."@en ;
    rdfs:domain :Player ;
    rdfs:range xsd:decimal .

# --- Stadium Data Properties ---

:stadiumCapacity
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stadium capacity"@en ;
    rdfs:comment "The maximum seating capacity of a stadium."@en ;
    rdfs:domain :Stadium ;
    rdfs:range xsd:integer .

:stadiumCity
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stadium city"@en ;
    rdfs:comment "The city where the stadium is located."@en ;
    rdfs:domain :Stadium ;
    rdfs:range xsd:string .

# --- Match Data Properties ---

:matchDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "match date"@en ;
    rdfs:comment "The date on which a match is played."@en ;
    rdfs:domain :Match ;
    rdfs:range xsd:date .

:matchWeek
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "match week"@en ;
    rdfs:comment "The league week number (hafta) in which the match is played."@en ;
    rdfs:domain :Match ;
    rdfs:range xsd:integer .

:homeScore
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "home score"@en ;
    rdfs:comment "The number of goals scored by the home team."@en ;
    rdfs:domain :Match ;
    rdfs:range xsd:integer .

:awayScore
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "away score"@en ;
    rdfs:comment "The number of goals scored by the away team."@en ;
    rdfs:domain :Match ;
    rdfs:range xsd:integer .

# --- Goal Data Properties ---

:goalMinute
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "goal minute"@en ;
    rdfs:comment "The minute of the match in which the goal was scored."@en ;
    rdfs:domain :Goal ;
    rdfs:range xsd:integer .

:isOwnGoal
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is own goal"@en ;
    rdfs:comment "Indicates whether the goal was an own goal."@en ;
    rdfs:domain :Goal ;
    rdfs:range xsd:boolean .

:isPenalty
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is penalty"@en ;
    rdfs:comment "Indicates whether the goal was scored from a penalty kick."@en ;
    rdfs:domain :Goal ;
    rdfs:range xsd:boolean .

# --- Card Data Properties ---

:cardMinute
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card minute"@en ;
    rdfs:comment "The minute of the match in which the card was shown."@en ;
    rdfs:domain :Card ;
    rdfs:range xsd:integer .

:cardReason
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card reason"@en ;
    rdfs:comment "The reason for the card being shown (e.g., foul, unsporting behavior)."@en ;
    rdfs:domain :Card ;
    rdfs:range xsd:string .

# --- Transfer Data Properties ---

:transferDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transfer date"@en ;
    rdfs:comment "The date on which the transfer was completed."@en ;
    rdfs:domain :Transfer ;
    rdfs:range xsd:date .

:transferFee
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transfer fee"@en ;
    rdfs:comment "The transfer fee amount in euros."@en ;
    rdfs:domain :Transfer ;
    rdfs:range xsd:decimal .

:isLoan
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is loan"@en ;
    rdfs:comment "Indicates whether the transfer is a loan deal rather than a permanent transfer."@en ;
    rdfs:domain :Transfer ;
    rdfs:range xsd:boolean .

# --- Season Data Properties ---

:seasonYear
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "season year"@en ;
    rdfs:comment "The year or year range of the season (e.g., 2024-2025)."@en ;
    rdfs:domain :Season ;
    rdfs:range xsd:string .

# --- League Data Properties ---

:leagueCountry
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "league country"@en ;
    rdfs:comment "The country where the league is based."@en ;
    rdfs:domain :League ;
    rdfs:range xsd:string .

# =============================================================================
# NAMED INDIVIDUALS (Position Instances)
# =============================================================================

:goalkeeper_position
    a :Goalkeeper ;
    rdfs:label "Goalkeeper"@en ;
    rdfs:comment "The goalkeeper position."@en .

:defender_position
    a :Defender ;
    rdfs:label "Defender"@en ;
    rdfs:comment "The defender position."@en .

:midfielder_position
    a :Midfielder ;
    rdfs:label "Midfielder"@en ;
    rdfs:comment "The midfielder position."@en .

:forward_position
    a :Forward ;
    rdfs:label "Forward"@en ;
    rdfs:comment "The forward position."@en .
