            rdfs:comment "The minute of the match in which the goal was scored."@en ;
            rdfs:label "goal minute"@en .


###  http://example.org/tsl-ontology#goalsAgainst
:goalsAgainst rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Standing ;
              rdfs:range xsd:integer ;
              rdfs:comment "Total goals conceded by the team in the season."@en ;
              rdfs:label "goals against"@en .


###  http://example.org/tsl-ontology#goalsFor
:goalsFor rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Standing ;
          rdfs:range xsd:integer ;
          rdfs:comment "Total goals scored by the team in the season."@en ;
          rdfs:label "goals for"@en .


###  http://example.org/tsl-ontology#homeScore
:homeScore rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Match ;
           rdfs:range xsd:integer ;
           rdfs:comment "The number of goals scored by the home team."@en ;
           rdfs:label "home score"@en .


###  http://example.org/tsl-ontology#isLoan
:isLoan rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Transfer ;
        rdfs:range xsd:boolean ;
        rdfs:comment "Indicates whether the transfer is a loan deal rather than a permanent transfer."@en ;
        rdfs:label "is loan"@en .


###  http://example.org/tsl-ontology#isOwnGoal
:isOwnGoal rdf:type owl:DatatypeProperty ,
