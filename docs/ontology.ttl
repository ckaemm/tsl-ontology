:awayScore rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Match ;
           rdfs:range xsd:integer ;
           rdfs:comment "The number of goals scored by the away team."@en ;
           rdfs:label "away score"@en .


