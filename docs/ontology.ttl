#################################################################
#    Classes
#################################################################

###  http://example.org/tsl-ontology#Card
:Card rdf:type owl:Class ;
      rdfs:subClassOf :MatchEvent ;
      rdfs:comment "A disciplinary card shown to a player by the referee during a match."@en ;
      rdfs:label "Card"@en .


###  http://example.org/tsl-ontology#Coach
:Coach rdf:type owl:Class ;
       rdfs:subClassOf :Person ;
       owl:disjointWith :Player ;
       rdfs:comment "A head coach or manager responsible for leading a team."@en ;
       rdfs:label "Coach"@en .


###  http://example.org/tsl-ontology#Defender
:Defender rdf:type owl:Class ;
          rdfs:subClassOf :Position ;
          owl:disjointWith :Forward ,
                           :Goalkeeper ,
                           :Midfielder ;
          rdfs:comment "A player position focused on preventing the opposing team from scoring."@en ;
          rdfs:label "Defender"@en .


###  http://example.org/tsl-ontology#Forward
:Forward rdf:type owl:Class ;
         rdfs:subClassOf :Position ;
         owl:disjointWith :Goalkeeper ,
                          :Midfielder ;
         rdfs:comment "A player position primarily responsible for scoring goals."@en ;
         rdfs:label "Forward"@en .


###  http://example.org/tsl-ontology#Goal
:Goal rdf:type owl:Class ;
      rdfs:subClassOf :MatchEvent ;
      rdfs:comment "A goal scored by a player during a match."@en ;
      rdfs:label "Goal"@en .


###  http://example.org/tsl-ontology#Goalkeeper
:Goalkeeper rdf:type owl:Class ;
            rdfs:subClassOf :Position ;
            owl:disjointWith :Midfielder ;
            rdfs:comment "The player position responsible for guarding the goal."@en ;
            rdfs:label "Goalkeeper"@en .


###  http://example.org/tsl-ontology#League
:League rdf:type owl:Class ;
        rdfs:comment "A professional football league organization that hosts competitive seasons."@en ;
        rdfs:label "League"@en .


###  http://example.org/tsl-ontology#Match
:Match rdf:type owl:Class ;
       rdfs:subClassOf <http://schema.org/SportsEvent> ;
       rdfs:comment "A competitive football match played between two teams within a league season."@en ;
       rdfs:label "Match"@en .


###  http://example.org/tsl-ontology#MatchEvent
:MatchEvent rdf:type owl:Class ;
            rdfs:comment "An event that occurs during a football match, such as a goal or a card."@en ;
            rdfs:label "Match Event"@en .


###  http://example.org/tsl-ontology#Midfielder
:Midfielder rdf:type owl:Class ;
            rdfs:subClassOf :Position ;
            rdfs:comment "A player position that operates in the middle of the field, linking defense and attack."@en ;
            rdfs:label "Midfielder"@en .


###  http://example.org/tsl-ontology#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ;
        rdfs:comment "A human individual involved in professional football."@en ;
        rdfs:label "Person"@en .


###  http://example.org/tsl-ontology#Player
:Player rdf:type owl:Class ;
        rdfs:subClassOf :Person ;
        rdfs:comment "A professional football player who is registered to play for a team."@en ;
        rdfs:label "Player"@en .


###  http://example.org/tsl-ontology#Position
:Position rdf:type owl:Class ;
          rdfs:comment "A playing position on the football field."@en ;
          rdfs:label "Position"@en .


###  http://example.org/tsl-ontology#RedCard
:RedCard rdf:type owl:Class ;
         rdfs:subClassOf :Card ;
         owl:disjointWith :YellowCard ;
         rdfs:comment "A dismissal card shown to a player, resulting in ejection from the match."@en ;
         rdfs:label "Red Card"@en .


###  http://example.org/tsl-ontology#Season
:Season rdf:type owl:Class ;
        rdfs:comment "A specific competitive season within a league, typically spanning one year (e.g., 2024-2025)."@en ;
        rdfs:label "Season"@en .


###  http://example.org/tsl-ontology#Stadium
:Stadium rdf:type owl:Class ;
         rdfs:subClassOf <http://schema.org/StadiumOrArena> ;
         rdfs:comment "A sports venue where football matches are played."@en ;
         rdfs:label "Stadium"@en .


###  http://example.org/tsl-ontology#Standing
:Standing rdf:type owl:Class ;
          rdfs:comment "A team's position and statistics in the league standings for a specific season."@en ;
          rdfs:label "Standing"@en .


###  http://example.org/tsl-ontology#Team
:Team rdf:type owl:Class ;
      rdfs:subClassOf <http://schema.org/SportsTeam> ;
      rdfs:comment "A professional football club that participates in a league."@en ;
      rdfs:label "Team"@en .


###  http://example.org/tsl-ontology#Transfer
:Transfer rdf:type owl:Class ;
          rdfs:comment "A player transfer transaction between two clubs, recording the movement of a player from one team to another."@en ;
          rdfs:label "Transfer"@en .


###  http://example.org/tsl-ontology#YellowCard
:YellowCard rdf:type owl:Class ;
            rdfs:subClassOf :Card ;
            rdfs:comment "A caution card shown to a player for a minor foul or unsporting behavior."@en ;
            rdfs:label "Yellow Card"@en .


###  http://schema.org/SportsEvent
<http://schema.org/SportsEvent> rdf:type owl:Class .


###  http://schema.org/SportsTeam
<http://schema.org/SportsTeam> rdf:type owl:Class .


###  http://schema.org/StadiumOrArena
<http://schema.org/StadiumOrArena> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class .


