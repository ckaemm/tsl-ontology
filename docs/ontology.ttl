:cardMinute rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:integer ;
            rdfs:comment "The minute of the match in which the card was shown."@en ;
            rdfs:label "card minute"@en .


###  http://example.org/tsl-ontology#cardReason
:cardReason rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:comment "The reason for the card being shown (e.g., foul, unsporting behavior)."@en ;
            rdfs:label "card reason"@en .


