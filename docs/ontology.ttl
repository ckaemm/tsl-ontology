@prefix : <http://example.org/tsl-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/tsl-ontology#> .

<http://example.org/tsl-ontology> rdf:type owl:Ontology ;
                                   <http://purl.org/dc/elements/1.1/creator> "Cemil and Group Members" ;
                                   <http://purl.org/dc/elements/1.1/description> "A formal knowledge model for professional football in the Turkish Super Lig, covering teams, players, matches, goals, cards, transfers, stadiums, and coaching staff."@en ;
                                   <http://purl.org/dc/elements/1.1/title> "Turkish Super Lig Football Ontology"@en ;
                                   <http://purl.org/dc/terms/created> "2026-04-28"^^xsd:date ;
                                   <http://purl.org/vocab/vann/preferredNamespacePrefix> "tsl" ;
                                   <http://purl.org/vocab/vann/preferredNamespaceUri> "http://example.org/tsl-ontology#" ;
                                   owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/tsl-ontology#assistedBy
:assistedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Goal ;
            rdfs:range :Player ;
            rdfs:comment "The player who provided the assist for a goal."@en ;
            rdfs:label "assisted by"@en .


###  http://example.org/tsl-ontology#awayTeam
:awayTeam rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Match ;
          rdfs:range :Team ;
          rdfs:comment "The visiting team in a match."@en ;
          rdfs:label "away team"@en .


###  http://example.org/tsl-ontology#belongsToLeague
:belongsToLeague rdf:type owl:ObjectProperty ;
                 rdfs:domain :Team ;
                 rdfs:range :League ;
                 rdfs:comment "Indicates that a team participates in a specific league."@en ;
                 rdfs:label "belongs to league"@en .


###  http://example.org/tsl-ontology#cardInMatch
:cardInMatch rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Card ;
             rdfs:range :Match ;
             rdfs:comment "The match in which the card was shown."@en ;
             rdfs:label "card in match"@en .


###  http://example.org/tsl-ontology#cardShownTo
:cardShownTo rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Card ;
             rdfs:range :Player ;
             rdfs:comment "The player who received the card."@en ;
             rdfs:label "card shown to"@en .


###  http://example.org/tsl-ontology#eventInMatch
:eventInMatch rdf:type owl:ObjectProperty ;
              rdfs:domain :MatchEvent ;
              rdfs:range :Match ;
              rdfs:comment "Links a match event to the match it occurred in."@en ;
              rdfs:label "event in match"@en .


###  http://example.org/tsl-ontology#goalForTeam
:goalForTeam rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Goal ;
             rdfs:range :Team ;
             owl:propertyChainAxiom ( :scoredBy
                                      :playsFor
                                    ) ;
             rdfs:comment "The team that scored the goal."@en ;
             rdfs:label "goal for team"@en .


###  http://example.org/tsl-ontology#goalInMatch
:goalInMatch rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Goal ;
             rdfs:range :Match ;
             rdfs:comment "The match in which a goal was scored."@en ;
             rdfs:label "goal in match"@en .


###  http://example.org/tsl-ontology#hasPlayer
:hasPlayer rdf:type owl:ObjectProperty ;
           owl:inverseOf :playsFor ;
           rdfs:domain :Team ;
           rdfs:range :Player ;
           rdfs:comment "Indicates that a team has a specific player in its roster."@en ;
           rdfs:label "has player"@en .


###  http://example.org/tsl-ontology#hasPosition
:hasPosition rdf:type owl:ObjectProperty ;
             rdfs:domain :Player ;
             rdfs:range :Position ;
             rdfs:comment "Indicates the playing position of a player on the field."@en ;
             rdfs:label "has position"@en .


###  http://example.org/tsl-ontology#homeStadium
:homeStadium rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Team ;
             rdfs:range :Stadium ;
             rdfs:comment "The home stadium of a team."@en ;
             rdfs:label "home stadium"@en .


###  http://example.org/tsl-ontology#homeTeam
:homeTeam rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Match ;
          rdfs:range :Team ;
          rdfs:comment "The team playing at home in a match."@en ;
          rdfs:label "home team"@en .


###  http://example.org/tsl-ontology#inSeason
:inSeason rdf:type owl:ObjectProperty ;
          rdfs:range :Season ;
          rdfs:comment "Indicates the season in which a match or transfer takes place."@en ;
          rdfs:label "in season"@en .


###  http://example.org/tsl-ontology#managedBy
:managedBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Team ;
           rdfs:range :Coach ;
           rdfs:comment "Indicates the head coach who manages a team in a given context."@en ;
           rdfs:label "managed by"@en .


###  http://example.org/tsl-ontology#manages
:manages rdf:type owl:ObjectProperty ;
         owl:inverseOf :managedBy ;
         rdfs:domain :Coach ;
         rdfs:range :Team ;
         rdfs:comment "Indicates which team a coach is managing."@en ;
         rdfs:label "manages"@en .


###  http://example.org/tsl-ontology#playedAtStadium
:playedAtStadium rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Match ;
                 rdfs:range :Stadium ;
                 rdfs:comment "The stadium where a match is played."@en ;
                 rdfs:label "played at stadium"@en .


###  http://example.org/tsl-ontology#playsFor
:playsFor rdf:type owl:ObjectProperty ;
          rdfs:domain :Player ;
          rdfs:range :Team ;
          rdfs:comment "Indicates which team a player is currently registered to play for."@en ;
          rdfs:label "plays for"@en .


###  http://example.org/tsl-ontology#scoredBy
:scoredBy rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Goal ;
          rdfs:range :Player ;
          rdfs:comment "The player who scored the goal."@en ;
          rdfs:label "scored by"@en .


###  http://example.org/tsl-ontology#seasonOfLeague
:seasonOfLeague rdf:type owl:ObjectProperty ;
                rdfs:domain :Season ;
                rdfs:range :League ;
                rdfs:comment "Links a season to the league it belongs to."@en ;
                rdfs:label "season of league"@en .


###  http://example.org/tsl-ontology#standingSeason
:standingSeason rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Standing ;
                rdfs:range :Season ;
                rdfs:comment "The season this standing record belongs to."@en ;
                rdfs:label "standing season"@en .


###  http://example.org/tsl-ontology#standingTeam
:standingTeam rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Standing ;
              rdfs:range :Team ;
              rdfs:comment "The team this standing record belongs to."@en ;
              rdfs:label "standing team"@en .


###  http://example.org/tsl-ontology#transferPlayer
:transferPlayer rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Transfer ;
                rdfs:range :Player ;
                rdfs:comment "The player who is being transferred."@en ;
                rdfs:label "transfer player"@en .


###  http://example.org/tsl-ontology#transferredFrom
:transferredFrom rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Transfer ;
                 rdfs:range :Team ;
                 rdfs:comment "The club that the player is leaving."@en ;
                 rdfs:label "transferred from"@en .


###  http://example.org/tsl-ontology#transferredTo
:transferredTo rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Transfer ;
               rdfs:range :Team ;
               rdfs:comment "The club that the player is joining."@en ;
               rdfs:label "transferred to"@en .


