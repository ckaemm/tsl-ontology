       rdfs:domain :Standing ;
       rdfs:range xsd:integer ;
       rdfs:comment "Number of matches drawn."@en ;
       rdfs:label "draws"@en .


###  http://example.org/tsl-ontology#goalMinute
:goalMinute rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Goal ;
