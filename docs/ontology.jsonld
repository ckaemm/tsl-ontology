  } ]
}, {
  "@id" : "http://example.org/tsl-ontology#Goalkeeper",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The player position responsible for guarding the goal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Goalkeeper"
  } ],
